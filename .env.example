# Supabaseプロジェクトの設定（本番・開発とも実際の値に置き換えること）
# .env.local を作ってこの内容をコピーする。.env* は .gitignore 済みでコミットされない。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 運営専用（PDF再発行不可の実施、record_payment_delay等の呼び出し）。
# クライアントに絶対に露出させない。Server Actionsからのみ使う。
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe（P7：課金）。まずはテストモードのキーで良い（Stripeダッシュボード → 開発者 → APIキー）。
STRIPE_SECRET_KEY=<stripeダッシュボードのシークレットキーに置き換える>
# Stripe CLI（stripe listen）またはダッシュボードのWebhookエンドポイント設定から取得
STRIPE_WEBHOOK_SECRET=<stripeのwebhook署名シークレットに置き換える>
# Stripeダッシュボードで作成した各プランのPrice ID（月額のrecurring price）
STRIPE_PRICE_STD=<standardプランのPrice IDに置き換える>
STRIPE_PRICE_PRO=<proプランのPrice IDに置き換える>
STRIPE_PRICE_PREM=<premiumプランのPrice IDに置き換える>

# Checkout/Customer Portalの戻り先URL。開発時はlocalhost、本番は実ドメインに変える。
NEXT_PUBLIC_APP_URL=http://localhost:3000
